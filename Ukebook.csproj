<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ukebook</AssemblyName>
    <RootNamespace>Ukebook</RootNamespace>
    <ApplicationIcon>Themes\Resources\ukulele.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Themes\Resources\ukulele.ico" />
    <Resource Include="Themes\Resources\ukulele.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Themes\Resources\chords\112x150\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
